# Inline lucide icons (https://lucide.dev/icons/), all on a 24-point grid with a 2-point stroke.

export type IconName =
  | 'arrow-up-down' | 'badge-check' | 'check' | 'chevron-left' | 'chevron-right' | 'clipboard'
  | 'columns' | 'compare' | 'copy' | 'download' | 'eye' | 'eye-off' | 'file' | 'folder'
  | 'github' | 'grid' | 'heart' | 'key' | 'link' | 'list' | 'lock' | 'monitor' | 'moon' | 'move'
  | 'panel-left' | 'panel-right' | 'pointer' | 'route' | 'search' | 'server' | 'shield' | 'star'
  | 'sun' | 'terminal' | 'upload' | 'window' | 'x' | 'zap'

export Icon = component extends svg
  @name: IconName
  @strokeWidth?: number := 2
  render
    svg
      viewBox: '0 0 24 24'
      fill: 'none'
      stroke: 'currentColor'
      stroke-width: strokeWidth
      stroke-linecap: 'round'
      stroke-linejoin: 'round'
      aria-hidden: 'true'
      switch name
        when 'arrow-up-down'
          path d: 'm21 16-4 4-4-4'
          path d: 'M17 20V4'
          path d: 'm3 8 4-4 4 4'
          path d: 'M7 4v16'
        when 'badge-check'
          path d: 'M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z'
          path d: 'm9 12 2 2 4-4'
        when 'check'
          path d: 'M20 6 9 17l-5-5'
        when 'chevron-left'
          path d: 'm15 18-6-6 6-6'
        when 'chevron-right'
          path d: 'm9 18 6-6-6-6'
        when 'clipboard'
          rect x: 8, y: 2, width: 8, height: 4, rx: 1
          path d: 'M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'
          path d: 'm9 14 2 2 4-4'
        when 'columns'
          rect x: 3, y: 3, width: 18, height: 18, rx: 2
          path d: 'M9 3v18'
          path d: 'M15 3v18'
        when 'compare'
          circle cx: 18, cy: 18, r: 3
          circle cx: 6, cy: 6, r: 3
          path d: 'M13 6h3a2 2 0 0 1 2 2v7'
          path d: 'M11 18H8a2 2 0 0 1-2-2V9'
        when 'copy'
          rect x: 8, y: 8, width: 14, height: 14, rx: 2
          path d: 'M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2'
        when 'download'
          path d: 'M12 15V3'
          path d: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'
          path d: 'm7 10 5 5 5-5'
        when 'eye'
