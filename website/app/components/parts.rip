import { Icon } from './icon.rip'

# A key as macOS draws one in its menus: Space, ⌘C, ⌥⌘V.
export Kbd = component
  render
    kbd class: 'inline-flex min-w-[1.6em] items-center justify-center rounded-md border border-strong border-b-2 bg-surface px-1.5 py-px font-sans text-[0.85em] font-semibold text-primary shadow-xs'
      slot

# A command to paste into Terminal, with a button that copies it.
export Command = component
  @text: string
  @prompt?: boolean := true
  copied := false

  copy: ->
    navigator.clipboard.writeText(text)
    copied = true
    setTimeout((-> copied = false), 1600)

  render
    div class: 'group flex items-center gap-3 rounded-xl border border-white/10 bg-code py-3 pr-2 pl-4 font-mono text-sm text-white/90 shadow-lg'
      if prompt
        span class: 'select-none text-cyan-brand', '$'
      code class: 'min-w-0 flex-1 overflow-x-auto whitespace-nowrap', text
      button
        type: 'button'
        class: 'flex size-8 shrink-0 items-center justify-center rounded-lg text-white/60 transition hover:bg-white/10 hover:text-white'
        aria-label: if copied then 'Copied' else 'Copy the command'
        @click: copy
        Icon name: (if copied then 'check' else 'copy'), class: 'size-4'

# A section's eyebrow, title, and words under it.
export Heading = component
  @eyebrow: string
  @title: string
  @lead?: string
  render
    div class: 'mx-auto max-w-2xl text-center'
      p class: 'text-sm font-semibold tracking-wide text-accent uppercase', eyebrow
      h2 class: 'mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl', title
      if lead
        p class: 'mt-4 text-lg text-pretty text-secondary', lead

# The eyebrow, title, and words that open one side of a two-column section.
export SideHeading = component
  @eyebrow: string
  @title: string
  render
    div
      p class: 'text-sm font-semibold tracking-wide text-accent uppercase', eyebrow
      h2 class: 'mt-3 font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl', title

# One feature: an icon in a soft tile, a title, and a sentence or two.
export Feature = component
  @icon: string
  @title: string
  @text: string
  render
    div class: 'rounded-2xl border border-surface bg-surface p-6 transition hover:-translate-y-0.5 hover:border-strong hover:shadow-lg'
      div class: 'flex size-10 items-center justify-center rounded-xl bg-accent-soft text-accent'
        Icon name: icon, class: 'size-5'
      h3 class: 'mt-4 font-semibold', title
      p class: 'mt-2 text-sm/6 text-secondary', text

# A point beside a picture: a small icon, a title, and a sentence.
export Point = component
  @icon: string
  @title: string
  @text: string
  render
    div class: 'flex gap-3'
      div class: 'flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-soft text-accent'
        Icon name: icon, class: 'size-4.5'
      div
        h3 class: 'font-semibold', title
        p class: 'mt-1 text-sm/6 text-secondary', text

# Light or dark: the head of the page set one already, and this switches and remembers it.
export ThemeToggle = component
  theme := document.documentElement.dataset.theme or 'light'

  ~> document.documentElement.dataset.theme = theme

  toggle: ->
    theme = if theme is 'dark' then 'light' else 'dark'
    try localStorage.setItem('theme', theme)

  render
    button
      type: 'button'
      class: 'flex size-9 items-center justify-center rounded-lg text-tertiary transition hover:bg-muted hover:text-primary'
      aria-label: if theme is 'dark' then 'Switch to the light theme' else 'Switch to the dark theme'
      @click: toggle
      Icon name: (if theme is 'dark' then 'sun' else 'moon'), class: 'size-4.5'
